{
  "manifest_version": 2,
  "name": "Wheel Momentum",
  "version": "1.0.0",
  "description": "Adds inertia to the mouse wheel: scrolling keeps gliding after you stop and settles smoothly.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wheel-momentum@local",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
