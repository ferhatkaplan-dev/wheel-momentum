[Unit]
Description=Wheel Momentum - inertial mouse wheel scrolling
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/wheel-momentum
Restart=on-failure
RestartSec=2
# If the event loop hangs, systemd kills it and the kernel drops the grab.
WatchdogSec=10
TimeoutStopSec=5

[Install]
WantedBy=default.target
