#!/usr/bin/env python3
"""
wheel-momentum -- system-wide inertial (momentum) mouse-wheel scrolling for Linux.

Two modes (config key "mode"):

  additive (default, cannot break input)
      The device is only *read*. The original detent is delivered natively and
      an extra decaying tail (multiplier - 1) is emitted on a separate virtual
      device. Nothing is ever taken over, so clicks/scroll can never be lost.

  grab (best feel, opt-in)
      The device is taken over with EVIOCGRAB and cloned 1:1 through uinput.
      Detents are replaced by a stream of high-resolution events, giving fully
      smooth travel from the first pixel. Fail-open: any forwarding problem
      immediately releases the device back to the kernel.

Safety nets in both modes:
  * every exception in a device handler releases that device (grab mode)
  * systemd watchdog (Type=notify) kills a hung daemon, which drops the grab
  * the kernel releases EVIOCGRAB automatically when the process dies

Usage:
  wheel-momentum                # run (no root, /dev/uinput access is enough)
  wheel-momentum --selftest     # verify math + uinput emission
  wheel-momentum --probe [sec]  # read-only: what does this device actually send?

Config: ~/.config/wheel-momentum/config.json (optional)
"""

import json
import os
import select
import signal
import socket
import sys
import time

try:
    import evdev
    from evdev import UInput, ecodes
except ImportError:
    sys.exit(
        "python-evdev is missing. Run ./install.sh from the repository, or:\n"
        "  python3 -m venv ~/.local/share/wheel-momentum/venv\n"
        "  ~/.local/share/wheel-momentum/venv/bin/pip install evdev"
    )

PREFIX = "Wheel Momentum"
UINPUT = "/dev/uinput"
SCAN_INTERVAL_MS = 3000
MAX_FORWARD_ERRORS = 20     # consecutive failures before a device is released
NOTIFY_INTERVAL_MS = 2000   # systemd watchdog ping rate

DEFAULT_CFG = {
    # "additive" = never grab (safe), "grab" = full takeover (smoother)
    "mode": "additive",
    # Total travel per detent (1.0 = exactly one detent, 1.4 = noticeable inertia)
    "multiplier": 1.4,
    # Damping: velocity is multiplied by this every 16.7 ms.
    # 0.90 = long glide, 0.93 = balanced, 0.96 = stops quickly.
    "friction": 0.93,
    # Emission rate (Hz)
    "hz": 125,
    # Velocity ceiling (hi-res units/ms; 120 units = one detent)
    "max_velocity": 4.0,
    # Animation stops below this velocity
    "stop_velocity": 0.02,
    # Device names to skip (case-insensitive substring match)
    "exclude": [],
    # If non-empty, only these device names are handled
    "include": [],
}

CONF_PATH = os.path.expanduser("~/.config/wheel-momentum/config.json")


def log(msg):
    print(f"[wheel-momentum] {msg}", flush=True)


def load_cfg():
    cfg = dict(DEFAULT_CFG)
    try:
        with open(CONF_PATH, encoding="utf-8") as f:
            cfg.update(json.load(f))
    except FileNotFoundError:
        pass
    except Exception as e:
        log(f"could not read config ({e}), using defaults")
    return cfg


def now_ms():
    return time.monotonic() * 1000.0


# --------------------------------------------------------------------------- #
# systemd notification + watchdog
# --------------------------------------------------------------------------- #
_sock = None


def sd_notify(state):
    global _sock
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        if _sock is None:
            _sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
            _sock.connect(addr)
        _sock.sendall(state.encode())
    except OSError:
        _sock = None


# --------------------------------------------------------------------------- #
# device handling
# --------------------------------------------------------------------------- #
class ForwardError(Exception):
    pass


class Handle:
    """One input device: momentum state plus (optionally) its uinput clone."""

    def __init__(self, dev, cfg, tail=None):
        self.dev = dev
        self.cfg = cfg
        self.grab = str(cfg.get("mode", "additive")).lower() == "grab"
        self.batch = []
        self.v = 0.0        # hi-res units / ms
        self.acc = 0.0      # rounding remainder
        self.last_emit = 0.0
        self.errors = 0
        self.forwarded = 0
        self.detents = 0
        self.frame_ms = 1000.0 / float(cfg["hz"])
        self.f_step = float(cfg["friction"]) ** (self.frame_ms / 16.7)

        if self.grab:
            self.ui = self._create_clone()
            self.owns_ui = True
        else:
            # Shared virtual mouse: only momentum is written to it, every real
            # event continues to reach the system through the physical device.
            self.ui = tail
            self.owns_ui = False
        self.out_path = self.ui.device.path
        if self.grab:
            try:
                dev.grab()
            except OSError:
                self.ui.close()
                raise

    def _create_clone(self):
        caps = {}
        for t, codes in self.dev.capabilities(absinfo=True).items():
            if t == ecodes.EV_SYN:
                continue
            caps[t] = list(codes)
        rel = caps.get(ecodes.EV_REL, [])
        if ecodes.REL_WHEEL_HI_RES not in rel:
            caps.setdefault(ecodes.EV_REL, []).append(ecodes.REL_WHEEL_HI_RES)
        info = self.dev.info
        return UInput(
            events=caps,
            name=self.dev.name,
            vendor=info.vendor or 1,
            product=info.product or 1,
            bustype=info.bustype or 3,
            version=info.version or 1,
            phys="wheel-momentum",
        )

    def update_cfg(self, cfg):
        """Apply a reloaded config without touching the device."""
        self.cfg = cfg
        self.frame_ms = 1000.0 / float(cfg["hz"])
        self.f_step = float(cfg["friction"]) ** (self.frame_ms / 16.7)
        vmax = float(cfg["max_velocity"])
        self.v = max(-vmax, min(vmax, self.v))

    # --- momentum ---
    def needs_emit(self, now):
        return self.v != 0.0 and now - self.last_emit >= self.frame_ms

    def kick(self, units, now):
        """Add one detent worth of travel (units: hi-res units)."""
        if not units:
            return
        v0 = units * float(self.cfg["multiplier"]) * (1.0 - self.f_step) / self.frame_ms
        vmax = float(self.cfg["max_velocity"])
        self.v = max(-vmax, min(vmax, self.v + v0))
        if self.last_emit <= 0.0:
            self.last_emit = now - self.frame_ms

    def maybe_emit(self, now):
        if self.v == 0.0 or now - self.last_emit < self.frame_ms:
            return
        dt = min(now - self.last_emit, 50.0)
        self.last_emit = now

        self.acc += self.v * dt
        n = int(self.acc)  # truncate toward zero
        if n:
            self.acc -= n
            try:
                self.ui.write(ecodes.EV_REL, ecodes.REL_WHEEL_HI_RES, n)
                self.ui.syn()
            except OSError as e:
                self.errors += 1
                if self.errors >= MAX_FORWARD_ERRORS:
                    raise ForwardError(f"cannot emit momentum: {e}")
                self.v = 0.0
                return

        self.v *= self.f_step ** (dt / self.frame_ms)
        if abs(self.v) < float(self.cfg["stop_velocity"]):
            self.v = 0.0
            self.acc = 0.0
            self.last_emit = 0.0

    # --- event handling ---
    def handle(self, ev, now):
        if ev.type == ecodes.EV_SYN and ev.code == ecodes.SYN_REPORT:
            self._flush(now)
            return
        self.batch.append(ev)

    def _flush(self, now):
        batch, self.batch = self.batch, []
        coarse = 0
        hires = 0
        for ev in batch:
            if ev.type == ecodes.EV_REL and ev.code in (ecodes.REL_WHEEL,
                                                        ecodes.REL_WHEEL_HI_RES):
                if ev.code == ecodes.REL_WHEEL:
                    coarse += ev.value
                else:
                    hires += ev.value
                continue
            if self.grab:
                self._forward(ev)

        # If the device reports both coarse and hi-res, trust hi-res.
        units = hires if hires else coarse * 120
        if units:
            self.detents += 1
            if not self.grab:
                # The detent itself was delivered natively; add only the tail.
                units *= max(0.0, float(self.cfg["multiplier"]) - 1.0)
            self.kick(units, now)

        if self.grab:
            self._forward_syn()

    def _forward(self, ev):
        try:
            self.ui.write_event(ev)
            self.forwarded += 1
            self.errors = 0
        except OSError as e:
            self.errors += 1
            if self.errors == 1 or self.errors % 20 == 0:
                name = ecodes.bytype.get(ev.type, {}).get(ev.code, ev.code)
                log(f"{self.dev.name}: cannot forward {ecodes.EV.get(ev.type, ev.type)}"
                    f"/{name} ({e}); errors={self.errors}")
            if self.errors >= MAX_FORWARD_ERRORS:
                raise ForwardError(f"cannot forward events: {e}")

    def _forward_syn(self):
        try:
            self.ui.write(ecodes.EV_SYN, ecodes.SYN_REPORT, 0)
        except OSError:
            pass

    def close(self):
        fns = [getattr(self.dev, "ungrab", None)]
        if self.owns_ui:
            fns.append(self.ui.close)
        fns.append(self.dev.close)
        for fn in fns:
            if fn is None:
                continue
            try:
                fn()
            except Exception:
                pass


def make_tail():
    """Virtual pointer that carries only momentum events.

    libinput ignores devices without buttons/axes, so this one advertises a
    normal mouse shape. Nothing but REL_WHEEL_HI_RES is ever written to it.
    """
    caps = {
        ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT, ecodes.BTN_MIDDLE],
        ecodes.EV_REL: [ecodes.REL_X, ecodes.REL_Y, ecodes.REL_WHEEL,
                        ecodes.REL_WHEEL_HI_RES],
    }
    return UInput(events=caps, name=f"{PREFIX} wheel", vendor=1, product=1,
                  bustype=3, version=1, phys="wheel-momentum")


def is_mouse(dev, cfg):
    if dev.name.startswith(PREFIX):
        return False
    name = dev.name.lower()
    if any(x.lower() in name for x in cfg["exclude"]):
        return False
    if cfg["include"] and not any(x.lower() in name for x in cfg["include"]):
        return False
    caps = dev.capabilities(absinfo=False)
    rel = caps.get(ecodes.EV_REL, [])
    keys = caps.get(ecodes.EV_KEY, [])
    abs_axes = caps.get(ecodes.EV_ABS, [])
    if ecodes.ABS_X in abs_axes:          # touchpad / tablet: leave alone
        return False
    if not (ecodes.REL_X in rel and ecodes.REL_Y in rel):
        return False
    if ecodes.REL_WHEEL not in rel and ecodes.REL_WHEEL_HI_RES not in rel:
        return False
    return ecodes.BTN_LEFT in keys


def scan(handles, mine, failed, cfg, tail):
    try:
        paths = evdev.list_devices()
    except Exception as e:
        log(f"could not list devices: {e}")
        return
    for path in paths:
        if path in handles or path in mine or path in failed:
            continue
        try:
            dev = evdev.InputDevice(path)
        except Exception:
            continue
        if not is_mouse(dev, cfg):
            dev.close()
            continue
        try:
            h = Handle(dev, cfg, tail)
        except OSError:
            dev.close()          # held by another process (EBUSY)
            continue
        except Exception as e:
            log(f"could not set up {path}: {e}")
            dev.close()
            failed.add(path)
            continue
        handles[path] = h
        mine.add(h.out_path)
        mode = " [grab]" if h.grab else " [additive]"
        log(f"attached: {dev.name} ({path} -> {h.out_path}){mode}")


def run(cfg):
    handles = {}
    mine = set()
    failed = set()
    running = True
    reload_req = False

    grab = str(cfg.get("mode", "additive")).lower() == "grab"
    tail = None if grab else make_tail()

    def stop(*_):
        nonlocal running
        running = False

    def reload(*_):
        nonlocal reload_req
        reload_req = True

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, reload)

    log(f"started (mode={cfg.get('mode', 'additive')})")
    last_scan = 0.0
    last_ping = 0.0
    while running:
        now = now_ms()
        if reload_req:
            reload_req = False
            new = load_cfg()
            new_grab = str(new.get("mode", "additive")).lower() == "grab"
            if new_grab != grab:
                log(f"mode changed -> {new.get('mode', 'additive')}, rebuilding devices")
                for h in list(handles.values()):
                    h.close()
                handles.clear()
                mine.clear()
                failed.clear()
                if tail is not None:
                    try:
                        tail.close()
                    except Exception:
                        pass
                    tail = None
                grab = new_grab
                tail = None if grab else make_tail()
                last_scan = 0.0
            else:
                for h in handles.values():
                    h.update_cfg(new)
                log("config reloaded")
            cfg = new
        if now - last_scan >= SCAN_INTERVAL_MS:
            scan(handles, mine, failed, cfg, tail)
            last_scan = now
            sd_notify("READY=1")
        if now - last_ping >= NOTIFY_INTERVAL_MS:
            sd_notify("WATCHDOG=1")
            last_ping = now

        if not handles:
            time.sleep(0.2)
            continue

        timeout = 0.5
        active = [h for h in handles.values() if h.v != 0.0]
        if active:
            wait = min(h.last_emit + h.frame_ms - now for h in active)
            timeout = max(0.001, min(wait / 1000.0, 0.5))

        fds = {h.dev.fd: path for path, h in handles.items()}
        try:
            ready, _, _ = select.select(list(fds), [], [], timeout)
        except (OSError, ValueError):
            ready = []

        now = now_ms()
        for fd in ready:
            path = fds[fd]
            h = handles[path]
            try:
                for ev in h.dev.read():
                    h.handle(ev, now)
            except ForwardError as e:
                log(f"{h.dev.name}: {e} -- releasing device back to the system")
                h.close()
                mine.discard(h.out_path)
                handles.pop(path, None)
                failed.add(path)
            except (OSError, BlockingIOError):
                log(f"device gone: {path}")
                h.close()
                mine.discard(h.out_path)
                handles.pop(path, None)

        for path, h in list(handles.items()):
            try:
                h.maybe_emit(now)
            except ForwardError as e:
                log(f"{h.dev.name}: {e} -- releasing device back to the system")
                h.close()
                mine.discard(h.out_path)
                handles.pop(path, None)
                failed.add(path)

    sd_notify("STOPPING=1")
    for h in list(handles.values()):
        h.close()
    if tail is not None:
        try:
            tail.close()
        except Exception:
            pass
    log("stopped")


def probe(seconds):
    """Read-only: report what the devices send. Touches nothing, grabs nothing."""
    ends = now_ms() + seconds * 1000
    devs = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except Exception:
            continue
        if is_mouse(d, DEFAULT_CFG):
            devs.append(d)
            log(f"probing: {d.name} ({path})")
        else:
            d.close()
    if not devs:
        log("no mouse-like devices found")
        return 1
    counts = {id(d): {} for d in devs}
    while now_ms() < ends:
        r, _, _ = select.select([d.fd for d in devs], [], [], 0.2)
        for d in devs:
            if d.fd not in r:
                continue
            for ev in d.read():
                key = (ecodes.EV.get(ev.type, ev.type),
                       ecodes.bytype.get(ev.type, {}).get(ev.code, ev.code))
                counts[id(d)][key] = counts[id(d)].get(key, 0) + 1
    for d in devs:
        log(f"{d.name}:")
        for (t, c), n in sorted(counts[id(d)].items(), key=lambda kv: -kv[1])[:12]:
            print(f"    {t} {c}: {n}")
        d.close()
    return 0


def selftest(cfg):
    """Verify real uinput emission and the math (touches no physical device)."""
    caps = {
        ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT],
        ecodes.EV_REL: [ecodes.REL_X, ecodes.REL_Y, ecodes.REL_WHEEL,
                        ecodes.REL_WHEEL_HI_RES],
    }
    ui = UInput(events=caps, name=f"{PREFIX} selftest", vendor=1, product=1,
                bustype=3, version=1)
    h = Handle.__new__(Handle)
    h.dev = None
    h.cfg = cfg
    h.grab = True
    h.batch = []
    h.v = 0.0
    h.acc = 0.0
    h.last_emit = 0.0
    h.errors = 0
    h.forwarded = 0
    h.detents = 0
    h.frame_ms = 1000.0 / float(cfg["hz"])
    h.f_step = float(cfg["friction"]) ** (h.frame_ms / 16.7)
    h.ui = ui
    h.out_path = ui.device.path

    t0 = now_ms()
    h.kick(120, t0)
    emitted = 0
    while h.v != 0.0 and now_ms() - t0 < 5000:
        if h.needs_emit(now_ms()):
            h.maybe_emit(now_ms())
            emitted += 1
        time.sleep(0.001)
    elapsed = now_ms() - t0
    ui.close()

    dt = h.frame_ms
    f = h.f_step
    v = 120 * float(cfg["multiplier"]) * (1 - f) / dt
    dist = 0.0
    steps = 0
    while abs(v) >= float(cfg["stop_velocity"]):
        dist += v * dt
        v *= f
        steps += 1

    log(f"selftest: 1 detent -> {dist:.0f} hi-res units (~{dist/120:.2f} detents), "
        f"{steps * dt:.0f} ms, {steps} emissions, real duration {elapsed:.0f} ms, "
        f"{emitted} loop iterations")
    return 0


def main():
    cfg = load_cfg()
    if "--selftest" in sys.argv:
        return selftest(cfg)
    if "--probe" in sys.argv:
        i = sys.argv.index("--probe")
        secs = float(sys.argv[i + 1]) if len(sys.argv) > i + 1 else 5.0
        return probe(secs)
    if not os.access(UINPUT, os.W_OK):
        log(f"{UINPUT} is not writable (needs the input group or a udev rule)")
        return 1
    try:
        run(cfg)
    except Exception as e:
        log(f"error: {e}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
