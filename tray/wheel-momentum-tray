# app
# --------------------------------------------------------------------------- #
class Tray:
    def __init__(self):
        global LANG
        self.cfg = load_cfg()
        LANG = resolve_lang(self.cfg)
        print(f"[tray] language={LANG}", flush=True)
        self._pending = 0
        self._building = False

        GLib.set_prgname(APP_ID)
        GLib.set_application_name("Wheel Momentum")

        self.icon_on = make_icon(True)
        self.icon_off = make_icon(False)

        self.win = self._build_window()

        self.ind = AppIndicator.Indicator.new(
            APP_ID, self.icon_on, AppIndicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.ind.set_title("Wheel Momentum")
        self._build_menu()
        self.sync()

        GLib.timeout_add_seconds(2, self._tick)

    # ---------------- menu ----------------
    def _build_menu(self):
        menu = Gtk.Menu()

        self.mi_on = Gtk.CheckMenuItem(label=t("menu.enabled"))
        self.mi_on.connect("toggled", self._on_menu_toggle)
        menu.append(self.mi_on)

        presets = Gtk.MenuItem(label=t("menu.presets"))
        sub = Gtk.Menu()
        self.preset_items = []
        group = None
        for name, mult, fric in PRESETS:
            it = Gtk.RadioMenuItem(label=t("preset." + name))
            if group is None:
                group = it
            else:
                it.join_group(group)
            it.connect("activate", self._on_menu_preset, mult, fric)
            sub.append(it)
            self.preset_items.append((it, mult, fric))
        presets.set_submenu(sub)
        menu.append(presets)

        mi_settings = Gtk.MenuItem(label=t("menu.settings"))
        mi_settings.connect("activate", lambda *_: self.show_window())
        menu.append(mi_settings)

        menu.append(Gtk.SeparatorMenuItem())

        self.mi_tray_auto = Gtk.CheckMenuItem(label=t("menu.autostart"))
        self.mi_tray_auto.connect("toggled", self._on_menu_autostart)
        menu.append(self.mi_tray_auto)

        mi_quit = Gtk.MenuItem(label=t("menu.quit"))
        mi_quit.connect("activate", self._on_quit)
        menu.append(mi_quit)

        menu.show_all()
        self.menu = menu
        self.ind.set_menu(menu)

    def _on_menu_toggle(self, item):
        if self._building:
            return
        if item.get_active():
            svc_on()
        else:
            svc_off()
        self.sync()

    def _on_menu_preset(self, item, mult, fric):
        if self._building or not item.get_active():
            return
        self.apply_preset(mult, fric)

    def _on_menu_autostart(self, item):
        if self._building:
            return
        if item.get_active():
            sc("enable", TRAY_SERVICE)
        else:
            sc("disable", TRAY_SERVICE)
        self.sync()

    def _on_quit(self, *_):
        Gtk.main_quit()

    # ---------------- window ----------------
    def _build_window(self):
        win = Gtk.Window(title=t("window.title"))
        win.set_default_size(460, -1)
        win.set_border_width(16)
        win.connect("delete-event", self._on_delete)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        win.add(outer)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title = Gtk.Label(xalign=0)
        title.set_markup("<b>Wheel Momentum</b>")
        head.pack_start(title, True, True, 0)
        self.sw = Gtk.Switch()
        self.sw.set_tooltip_text(wrapped(t("switch.tip")))
        self.sw.set_has_tooltip(True)
        self.sw.connect("notify::active", self._on_switch)
        head.pack_end(self.sw, False, False, 0)
        outer.pack_start(head, False, False, 0)

        self.status = Gtk.Label(xalign=0)
        self.status.get_style_context().add_class("dim-label")
        outer.pack_start(self.status, False, False, 0)

        outer.pack_start(Gtk.Separator(), False, False, 0)

        lbl = Gtk.Label(label=t("presets"), xalign=0)
        outer.pack_start(lbl, False, False, 0)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_homogeneous(True)
        self.preset_btns = []
        for name, mult, fric in PRESETS:
            b = Gtk.Button(label=t("preset." + name))
            b.set_tooltip_text(wrapped(t("preset." + name + ".tip")))
            b.connect("clicked", lambda _b, m=mult, f=fric: self.apply_preset(m, f))
            box.pack_start(b, True, True, 0)
            self.preset_btns.append(b)
        outer.pack_start(box, False, False, 0)

        outer.pack_start(Gtk.Separator(), False, False, 0)

        self.s_mult = SliderRow(
            t("row.multiplier"),
            t("row.multiplier.hint"),
            "row.multiplier.tip",
            0.6, 2.6, 0.05, 2, "×")
        self.s_fric = SliderRow(
            t("row.friction"),
            t("row.friction.hint"),
            "row.friction.tip",
            0.85, 0.99, 0.005, 3)
        self.s_hz = SliderRow(
            t("row.hz"),
            t("row.hz.hint"),
            "row.hz.tip",
            60, 240, 5, 0, " Hz")
        self.s_vel = SliderRow(
            t("row.velocity"),
            t("row.velocity.hint"),
            "row.velocity.tip",
            1.0, 8.0, 0.5, 1)

        for row in (self.s_mult, self.s_fric, self.s_hz, self.s_vel):
            outer.pack_start(row, False, False, 0)
            row.connect_changed(self._schedule_apply)

        outer.pack_start(Gtk.Separator(), False, False, 0)

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.cb_auto = Gtk.CheckButton(label=t("autostart"))
        self.cb_auto.set_tooltip_text(wrapped(t("autostart.tip")))
        self.cb_auto.connect("toggled", self._on_auto_toggle)
        bottom.pack_start(self.cb_auto, True, True, 0)
        b_reset = Gtk.Button(label=t("defaults"))
        b_reset.set_tooltip_text(wrapped(t("defaults.tip")))
        b_reset.connect("clicked", self._on_reset)
        bottom.pack_end(b_reset, False, False, 0)
        outer.pack_start(bottom, False, False, 0)

        self.cb_safe = Gtk.CheckButton(label=t("safe"))
        self.cb_safe.set_tooltip_text(wrapped(t("safe.tip")))
        self.cb_safe.connect("toggled", self._on_safe_toggle)
        outer.pack_start(self.cb_safe, False, False, 0)

        lang_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lang_lbl = Gtk.Label(label=t("language"), xalign=0)
        lang_lbl.set_hexpand(True)
        self.cb_lang = Gtk.ComboBoxText()
        self.cb_lang.append("auto", t("lang.auto"))
        self.cb_lang.append("en", "English")
        self.cb_lang.append("tr", "Türkçe")
        current = str(self.cfg.get("language", "auto"))
        self.cb_lang.set_active_id(current if current in ("auto", "en", "tr") else "auto")
        self.cb_lang.set_tooltip_text(wrapped(t("language.tip")))
        self.cb_lang.connect("changed", self._on_lang_change)
        lang_row.pack_start(lang_lbl, True, True, 0)
        lang_row.pack_end(self.cb_lang, False, False, 0)
        outer.pack_start(lang_row, False, False, 0)

        self._load_to_ui()
        return win

    def _on_delete(self, *_):
        self.win.hide()
        return True

    def show_window(self):
        self.sync()
        self.win.show_all()
        self.win.present()

    # ---------------- UI <-> config ----------------
    def _load_to_ui(self):
        self._building = True
        c = self.cfg
        self.s_mult.set_value(float(c["multiplier"]))
        self.s_fric.set_value(float(c["friction"]))
        self.s_hz.set_value(float(c["hz"]))
        self.s_vel.set_value(float(c["max_velocity"]))
        self.cb_safe.set_active(c.get("mode", "additive") != "grab")
        self._building = False

    def _ui_to_cfg(self):
        self.cfg["multiplier"] = round(self.s_mult.scale.get_value(), 2)
        self.cfg["friction"] = round(self.s_fric.scale.get_value(), 3)
        self.cfg["hz"] = int(self.s_hz.scale.get_value())
        self.cfg["max_velocity"] = round(self.s_vel.scale.get_value(), 1)

    def _schedule_apply(self):
        if self._building:
            return
        if self._pending:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(400, self._apply)

    def _apply(self):
        self._pending = 0
        self._ui_to_cfg()
        save_cfg(self.cfg)
        svc_reload()
        self.sync()
        return False

    def apply_preset(self, mult, fric):
        self.cfg["multiplier"] = mult
        self.cfg["friction"] = fric
        save_cfg(self.cfg)
        self._load_to_ui()
        svc_reload()
        self.sync()

    def _on_reset(self, *_):
        for k in ("multiplier", "friction", "hz", "max_velocity"):
            self.cfg[k] = DEFAULTS[k]
        save_cfg(self.cfg)
        self._load_to_ui()
        svc_reload()
        self.sync()

    def _on_switch(self, sw, _pspec):
        if self._building:
            return
        if sw.get_active():
            svc_on()
        else:
            svc_off()
        self.sync()

    def _on_safe_toggle(self, btn):
        if self._building:
            return
        self.cfg["mode"] = "additive" if btn.get_active() else "grab"
        save_cfg(self.cfg)
        svc_reload()
        self.sync()

    def _on_auto_toggle(self, btn):
        if self._building:
            return
        if btn.get_active():
            sc("enable", TRAY_SERVICE)
        else:
            sc("disable", TRAY_SERVICE)
        self.sync()

    def _on_lang_change(self, combo):
        if self._building:
            return
        choice = combo.get_active_id() or "auto"
        if choice == str(self.cfg.get("language", "auto")):
            return
        self.cfg["language"] = choice
        save_cfg(self.cfg)
        global LANG
        LANG = resolve_lang(self.cfg)
        self._rebuild_ui()

    def _rebuild_ui(self):
        """Rebuild menu and window after a language change."""
        was_visible = self.win.get_visible()
        old = self.win
        self.win = self._build_window()
        old.destroy()
        self._build_menu()
        self.sync()
        if was_visible:
            self.win.show_all()
            self.win.present()

    # ---------------- state sync ----------------
    def sync(self):
        state = svc_state()
        active = state in ("active", "activating", "reloading")
        enabled = svc_enabled()

        self._building = True
        self.sw.set_active(active)
        self.mi_on.set_active(active)
        self.mi_tray_auto.set_active(tray_enabled())
        self.cb_auto.set_active(tray_enabled())
        self.cb_safe.set_active(self.cfg.get("mode", "additive") != "grab")
        self._building = False

        if active:
            txt = t("enabled")
            self.ind.set_icon_full(self.icon_on, "Wheel Momentum")
        elif state == "failed":
            txt = t("failed")
            self.ind.set_icon_full(self.icon_off, "Wheel Momentum")
        else:
            txt = t("off") if enabled else t("off_login")
            self.ind.set_icon_full(self.icon_off, "Wheel Momentum")
        self.status.set_text(txt)
        self.ind.set_label("", "")
        self._match_preset()

    def _match_preset(self):
        for it, mult, fric in self.preset_items:
            if abs(mult - float(self.cfg["multiplier"])) < 0.001 and \
               abs(fric - float(self.cfg["friction"])) < 0.001:
                it.set_active(True)
                return

    def _tick(self):
        self.sync()
        return True


PIDFILE = os.path.join(ICON_DIR, "tray.pid")


def _already_running(path):
    try:
        with open(path, encoding="utf-8") as f:
            return int(f.read().strip())
    except Exception:
        return 0


def main():
    os.makedirs(ICON_DIR, exist_ok=True)
    want_show = "--show" in sys.argv

    # Single instance: if one is already running, ask it to show the window.
    pid = _already_running(PIDFILE)
    if pid and pid != os.getpid():
        try:
            os.kill(pid, 0)
        except OSError:
            pass
        else:
            try:
                os.kill(pid, signal.SIGUSR1)
            except OSError:
                pass
            return 0

    app = Tray()
    with open(PIDFILE, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))

    try:
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                            lambda *_: (app.show_window(), True)[1])
    except Exception:
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             lambda *_: (app.show_window(), True)[1])

    if want_show:
        app.show_window()
    Gtk.main()
    try:
        os.unlink(PIDFILE)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
