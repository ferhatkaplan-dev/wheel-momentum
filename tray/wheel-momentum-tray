LANG = "en"


def system_lang():
    values = [os.environ.get(v) for v in ("LC_ALL", "LC_MESSAGES", "LANG")]
    # Mixed locales are common (LANG=en_US for the terminal, tr_TR for dates):
    # any Turkish category is a strong hint about the preferred UI language.
    values += [v for k, v in os.environ.items() if k.startswith("LC_")]
    if any((v or "").lower().startswith("tr") for v in values):
        return "tr"
    return "en"


def resolve_lang(cfg):
    choice = str(cfg.get("language", "auto")).lower()
    return choice if choice in ("en", "tr") else system_lang()


def t(key):
    return STRINGS.get(LANG, STRINGS["en"]).get(key, STRINGS["en"].get(key, key))


def wrapped(text):
    """GTK tooltips do not wrap reliably; break the lines ourselves."""
    lines = []
    for para in text.split("\n"):
        lines.extend(textwrap.wrap(para, width=54) or [""])
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# config
# --------------------------------------------------------------------------- #
def load_cfg():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF_PATH, encoding="utf-8") as f:
            cfg.update(json.load(f))
    except Exception:
        pass
    return cfg


def save_cfg(cfg):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(CONF_PATH, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)


# --------------------------------------------------------------------------- #
# systemctl
# --------------------------------------------------------------------------- #
def sc(*args):
    try:
        return subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True, text=True, timeout=10,
        )
    except Exception:
        return None


def svc_state():
    """ActiveState, including transitional states."""
    r = sc("show", "-p", "ActiveState", "--value", SERVICE)
    return r.stdout.strip() if r and r.returncode == 0 else "unknown"


def svc_active():
    # "activating" matters: the unit is Type=notify and briefly not "active".
    return svc_state() in ("active", "activating", "reloading")


def svc_enabled():
    r = sc("is-enabled", "--quiet", SERVICE)
    return bool(r and r.returncode == 0)


def tray_enabled():
    r = sc("is-enabled", "--quiet", TRAY_SERVICE)
    return bool(r and r.returncode == 0)


def svc_on():
    sc("reset-failed", SERVICE)   # clears start-limit-hit from earlier restarts
    sc("enable", SERVICE)
    r = sc("start", SERVICE)
    return bool(r and r.returncode == 0)


def svc_off():
    sc("stop", SERVICE)
    sc("disable", SERVICE)


def svc_reload():
    """Apply the config without restarting (no systemd start rate-limit)."""
    if svc_active():
        sc("kill", "--signal=HUP", SERVICE)
    elif svc_enabled():
        sc("reset-failed", SERVICE)
        sc("start", SERVICE)


# --------------------------------------------------------------------------- #
# icons (drawn with cairo, no theme dependency)
# --------------------------------------------------------------------------- #
def _rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
    cr.arc(x + r, y + r, r, 3.1416, 4.7124)
    cr.close_path()


def make_icon(on):
    """Write the icon into the icon theme so hosts can resolve it by name."""
    name = "wheel-momentum-on" if on else "wheel-momentum-off"
    base = os.path.expanduser("~/.local/share/icons/hicolor")
    for size in (32, 64):
        out_dir = os.path.join(base, f"{size}x{size}", "apps")
        os.makedirs(out_dir, exist_ok=True)
        _draw_icon(on, os.path.join(out_dir, name + ".png"), size)
    try:
        subprocess.run(["gtk-update-icon-cache", "-f", "-t", base],
                       capture_output=True, timeout=10)
    except Exception:
        pass
    return name


def _draw_icon(on, path, S):
    k = S / 64.0
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, S, S)
    cr = cairo.Context(surf)
    cr.scale(k, k)

    if on:
        fg = (0.36, 0.66, 1.0, 1.0)
        bg = (0.36, 0.66, 1.0, 0.16)
    else:
        fg = (0.62, 0.62, 0.66, 1.0)
        bg = (0.62, 0.62, 0.66, 0.10)

    # body fill
    cr.set_source_rgba(*bg)
    _rounded_rect(cr, 17, 5, 30, 54, 15)
    cr.fill()

    # body outline
    cr.set_source_rgba(*fg)
    cr.set_line_width(4.2)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    _rounded_rect(cr, 17, 5, 30, 54, 15)
    cr.stroke()

    # wheel line
    cr.set_line_width(4.2)
    cr.move_to(32, 15)
    cr.line_to(32, 26)
    cr.stroke()

    if on:
        # motion waves
        cr.set_line_width(3.4)
        for r in (7, 13):
            cr.arc(32, 32, r, 0.35, 1.25)
            cr.stroke()
    else:
        # disabled: slash
        cr.set_line_width(5.5)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.move_to(14, 52)
        cr.line_to(50, 12)
        cr.stroke()

    surf.write_to_png(path)
    return path


def info_icon(key):
    """Small (i) badge whose tooltip explains the setting in detail."""
    tip = wrapped(t(key))
    box = Gtk.EventBox()
    box.set_valign(Gtk.Align.CENTER)
    box.set_visible_window(False)
    box.set_tooltip_text(tip)
    box.set_has_tooltip(True)
    theme = Gtk.IconTheme.get_default()
    if theme.has_icon("dialog-information-symbolic"):
        img = Gtk.Image.new_from_icon_name("dialog-information-symbolic",
                                           Gtk.IconSize.MENU)
        img.set_opacity(0.6)
        img.set_tooltip_text(tip)
        box.add(img)
    else:
        lbl = Gtk.Label(label="ⓘ")
        lbl.get_style_context().add_class("dim-label")
        box.add(lbl)
    return box


# --------------------------------------------------------------------------- #
# slider row
# --------------------------------------------------------------------------- #
class SliderRow(Gtk.Box):
    def __init__(self, title, hint, tip, lo, hi, step, digits, suffix=""):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.suffix = suffix
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.label = Gtk.Label(label=title, xalign=0)
        head.pack_start(self.label, False, False, 0)
        head.pack_start(info_icon(tip), False, False, 0)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        head.pack_start(spacer, True, True, 0)
        self.value = Gtk.Label(xalign=1)
        self.value.get_style_context().add_class("dim-label")
        head.pack_end(self.value, False, False, 0)
        self.pack_start(head, False, False, 0)

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        self.scale.set_digits(digits)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.pack_start(self.scale, False, False, 0)

        if hint:
            h = Gtk.Label(label=hint, xalign=0)
            h.get_style_context().add_class("dim-label")
            h.set_line_wrap(True)
            self.pack_start(h, False, False, 0)

        self.scale.connect("value-changed", self._on_change)
        self._cb = None

    def _fmt(self, v):
        return f"{v:.{self.scale.get_digits()}f}{self.suffix}"

    def _on_change(self, s):
        self.value.set_text(self._fmt(s.get_value()))
        if self._cb:
            self._cb()

    def connect_changed(self, cb):
        self._cb = cb

    def set_value(self, v):
        self.scale.handler_block_by_func(self._on_change)
        self.scale.set_value(v)
        self.scale.handler_unblock_by_func(self._on_change)
        self.value.set_text(self._fmt(v))


